[submodule "custom/plugins/zsh-completions"]
	path = custom/plugins/zsh-completions
	url = https://github.com/zsh-users/zsh-completions
	branch = master
[submodule "custom/plugins/zsh-kitty"]
	path = custom/plugins/zsh-kitty
	url = https://github.com/redxtech/zsh-kitty
	branch = master
[submodule "custom/plugins/zsh-history-substring-search"]
	path = custom/plugins/zsh-history-substring-search
	url = https://github.com/zsh-users/zsh-history-substring-search
	branch = master
[submodule "zsh-autocomplete"]
	path = custom/plugins/zsh-autocomplete
	url = https://github.com/marlonrichert/zsh-autocomplete.git
	branch = main
[submodule "zsh-patina"]
	path = custom/plugins/zsh-patina
	url = https://github.com/michel-kraemer/zsh-patina.git
	branch = main
